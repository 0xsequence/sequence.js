{
  "name": "sequence-core",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build:all": "turbo build",
    "build:packages": "turbo build --filter=\"./packages/**/*\"",
    "build": "pnpm build:packages",
    "dev": "turbo dev",
    "test": "turbo test --concurrency=1",
    "test:local": "./scripts/with-anvil.sh pnpm test",
    "lint": "turbo lint --continue",
    "format": "prettier --list-different --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "postinstall": "lefthook install",
    "dev:server": "node packages/wallet/primitives-cli/dist/index.js server",
    "reinstall": "rimraf -g ./**/node_modules && pnpm install",
    "test:anvil": "anvil --fork-url https://nodes.sequence.app/arbitrum",
    "clean": "turbo clean",
    "deps:lint": "syncpack lint --dependency-types prod,dev",
    "deps:fix": "syncpack fix",
    "test:release": "node --test scripts/*.test.mjs",
    "ci:stage-release": "node scripts/stage-npm-packages.mjs",
    "ci:release-gates": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:release && pnpm test:local"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.29.8",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "semver": "^7",
    "syncpack": "^14.3.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "ox": "^0.9.17"
    }
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=18"
  },
  "syncpack": {
    "source": [
      "package.json",
      "packages/**/package.json",
      "extras/**/package.json",
      "repo/**/package.json"
    ],
    "versionGroups": [
      {
        "label": "Use workspace protocol when developing local packages",
        "dependencyTypes": [
          "!local"
        ],
        "dependencies": [
          "$LOCAL"
        ],
        "pinVersion": "workspace:^"
      }
    ]
  }
}
