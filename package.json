{
  "name": "sequence-core",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build:all": "turbo build",
    "build:packages": "turbo build --filter=\"./packages/**/*\"",
    "build": "pnpm build:packages",
    "dev": "turbo dev",
    "test": "turbo test --concurrency=1",
    "test:local": "./scripts/with-anvil.sh pnpm test",
    "lint": "turbo lint --continue",
    "format": "prettier --list-different --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo typecheck",
    "postinstall": "lefthook install",
    "dev:server": "node packages/wallet/primitives-cli/dist/index.js server",
    "reinstall": "rimraf -g ./**/node_modules && pnpm install",
    "test:anvil": "anvil --fork-url https://nodes.sequence.app/arbitrum",
    "clean": "turbo clean",
    "deps:lint": "syncpack lint --dependency-types prod,dev",
    "deps:fix": "syncpack fix",
    "test:release": "node --test scripts/*.test.mjs",
    "ci:stage-release": "node scripts/stage-npm-packages.mjs",
    "ci:release-gates": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:release && pnpm test:local"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.29.8",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "semver": "^7",
    "syncpack": "^14.3.1",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=18"
  },
  "syncpack": {
    "source": [
      "package.json",
      "packages/**/package.json",
      "extras/**/package.json",
      "repo/**/package.json"
    ],
    "versionGroups": [
      {
        "label": "Use workspace protocol when developing local packages",
        "dependencyTypes": [
          "!local"
        ],
        "dependencies": [
          "$LOCAL"
        ],
        "pinVersion": "workspace:^"
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "ox": "^0.9.17",
      "minimatch@>=3.0.0 <3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "flatted@>=3.0.0 <3.4.2": "^3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "handlebars@>=4.0.0 <4.7.10": "^4.7.10",
      "shell-quote@>=1.0.0 <1.11.0": "^1.11.0",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "basic-ftp@>=5.0.0 <6.2.1": "^6.2.1",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "ip-address@>=10.0.0 <10.7.4": "^10.7.4",
      "zod@>=4.0.0 <4.6.6": "^4.6.6",
      "@humanfs/node@>=0.16.0 <0.16.8": "^0.16.8",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0"
    }
  }
}
